# Минимальная VFS: только пустой корневой каталог.
ls                  # пусто
ls -a               # только . и ..
ls -l /
cd ..               # выше корня подняться нельзя - остаёмся в /
ls -la ..
cd ~                # домашний каталог по умолчанию - корень
cd nowhere          # ошибка: каталога нет
