# Стартовый скрипт: демонстрация команд этапов 1-2.
# Комментарии записываются как в Python: всё после # игнорируется.

ls                                  # без аргументов
ls -l "My Documents" 'a b' c\ d     # кавычки и экранирование
cd "/home/user"
cd ""                               # пустой аргумент
ls a"b c"'d e'                      # склейка частей слова
ls "#не комментарий" a#b            # # внутри кавычек и слова - обычный символ
