# Стартовый скрипт: обработка ошибок.
# После ошибки выполнение продолжается, как в sh.

pwd                     # неизвестная команда -> код 127
ls "unclosed            # незакрытая двойная кавычка
cd 'unclosed            # незакрытая одинарная кавычка
exit 1 2                # слишком много аргументов: эмулятор не закрывается
ls после ошибок         # выполнение продолжается
