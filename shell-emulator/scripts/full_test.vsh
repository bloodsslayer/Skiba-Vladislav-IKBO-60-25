# Полный тест всех команд этапов 1-3 (запускать с vfs/deep.json).
cd -                              # ошибка: предыдущего каталога ещё нет

# --- Парсер: кавычки, экранирование, комментарии ---
ls "docs"                         # двойные кавычки
ls 'docs/reports'                 # одинарные кавычки
cd /home/user/"docs"/'reports'    # склейка частей пути
cd ~
ls docs/re"ports"/20\24           # экранирование и склейка
ls "#не комментарий"              # # в кавычках - часть аргумента
ls ~/docs "~"                     # ~ раскрывается только вне кавычек
ls "незакрытая кавычка            # синтаксическая ошибка
ls 'тоже незакрытая               # синтаксическая ошибка

# --- ls: все режимы ---
ls
ls -a
ls -l
ls -la /
ls -l -a /etc
ls -- -l                          # после -- аргумент не опция
ls /etc/passwd /bin               # файл и каталог
ls docs projects                  # несколько каталогов
ls -z                             # ошибка: неизвестная опция
ls /nowhere                       # ошибка: нет такого пути
ls /etc/passwd/x                  # ошибка: passwd не каталог
ls docs nowhere                   # ошибка в одном из аргументов

# --- cd: все режимы ---
cd /var/log
cd ../..                          # относительный путь с ..
cd -                              # назад, печатает путь
cd ~/projects/emulator/src
cd ../../..                       # обратно домой
cd /
cd                                # без аргумента - домой
cd ~/docs/./reports/../reports/2024
cd /no/such/dir                   # ошибка: нет каталога
cd /etc/hostname                  # ошибка: не каталог
cd /tmp /var                      # ошибка: слишком много аргументов
cd ""                             # пустой аргумент - остаёмся на месте

# --- Неизвестные команды и exit ---
pwd                               # команда не найдена
cat /etc/hostname                 # команда не найдена
exit 1 2                          # ошибка: слишком много аргументов, не выходим
ls -l ~/docs/photo.png            # двоичный файл из base64
